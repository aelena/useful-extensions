<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Aelena.CommonExtensions</RootNamespace>
    <AssemblyName>Aelena.CommonExtensions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- The nuget.org package keeps the historical id; assembly and namespace are Aelena.CommonExtensions. -->
    <PackageId>Common-Extensions</PackageId>
    <Version>2.3.1</Version>
    <Description>A small, opinionated set of extension methods that fill real gaps in the .NET BCL for strings, sequences and comparable values.</Description>
    <PackageTags>extensions;string;linq;enumerable;utility</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2013-2026 Antonio Elena</Copyright>
    <PackageProjectUrl>https://github.com/aelena/useful-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aelena/useful-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See https://github.com/aelena/useful-extensions/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <!-- Source Link: embed the commit in the nuspec and PDB so consumers can step into the code. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'net8.0'">true</IsAotCompatible>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- .NET Standard 2.0 needs Span<T> from a package and compile-time polyfills for Index/Range and the
       nullability and caller-info attributes. PolySharp is a source generator; nothing of it ships in the package.
       InlineArrayAttribute is excluded on purpose: the .NET Framework runtime does not understand inline arrays,
       so the compiler must fall back to arrays for params ReadOnlySpan<T>. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PolySharpExcludeGeneratedTypes>System.Runtime.CompilerServices.InlineArrayAttribute</PolySharpExcludeGeneratedTypes>
  </PropertyGroup>

</Project>
