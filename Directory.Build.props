<Project>

  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dependency audit at restore time, including transitive packages. NU1900 (advisory feed unreachable)
         and NU1901 (low severity) stay warnings; moderate, high and critical vulnerabilities fail the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>NU1900;NU1901</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Antonio Elena</Authors>
    <Product>Aelena.Extensions</Product>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
